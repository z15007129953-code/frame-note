{
  "name": "frame-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test src/domain/*.test.ts src/db/*.test.ts src/storage/*.test.ts src/server/*.test.ts",
    "dev": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4310",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:db": "node --env-file-if-exists=.env.local --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local src/db/migrate-cli.ts",
    "db:local": "node scripts/local-db.mjs"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
